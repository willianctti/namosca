# Axobug's public Neuro API is used by the optional `axobug` engine.
# The public alpha currently does not require an API key.
AXOBUG_BASE_URL=https://axobug.com
# O alpha público atual não exige token; preencha apenas se o serviço mudar.
AXOBUG_API_TOKEN=
AXOBUG_TIMEOUT_SECONDS=20

# Optional FlyWire/Codex-compatible JSON graph endpoint. Codex normally
# requires authentication; never commit a token here.
FLYWIRE_GRAPH_URL=
FLYWIRE_API_TOKEN=
FLYWIRE_TIMEOUT_SECONDS=20
# Optional local normalized JSON graph, useful for offline development.
# There is no mock fallback when this is empty.
FLYWIRE_DATA_FILE=

# Safety limits keep a browser session small even if a remote file is huge.
MAX_GRAPH_NEURONS=1200
MAX_GRAPH_SYNAPSES=6000
MAX_REMOTE_BYTES=12000000
CACHE_SIZE=4

# Comma-separated origins, or * for local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
